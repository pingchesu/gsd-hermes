{
  "name": "gsd-hermes",
  "version": "1.37.1",
  "description": "A get-shit-done fork that adds Hermes Agent runtime support while preserving upstream GSD workflows.",
  "bin": {
    "gsd-hermes": "bin/install.js",
    "get-shit-done-cc": "bin/install.js"
  },
  "files": [
    "bin",
    "commands",
    "get-shit-done",
    "agents",
    "hooks",
    "scripts",
    "sdk/src",
    "sdk/prompts",
    "sdk/package.json",
    "sdk/package-lock.json",
    "sdk/tsconfig.json",
    "docs/hermes-install.md",
    "docs/hermes-compatibility.md",
    "docs/upstream-sync.md"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "meta-prompting",
    "context-engineering",
    "spec-driven-development",
    "gemini",
    "gemini-cli",
    "codex",
    "codex-cli",
    "gsd",
    "hermes",
    "hermes-agent"
  ],
  "author": "TÂCHES",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pingchesu/gsd-hermes.git"
  },
  "homepage": "https://github.com/pingchesu/gsd-hermes",
  "bugs": {
    "url": "https://github.com/pingchesu/gsd-hermes/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "esbuild": "^0.24.0",
    "vitest": "^4.1.2"
  },
  "scripts": {
    "build:hooks": "node scripts/build-hooks.js",
    "prepublishOnly": "npm run build:hooks",
    "test:hermes": "node scripts/validate-hermes-compat.cjs",
    "test": "node scripts/run-tests.cjs",
    "test:coverage": "c8 --check-coverage --lines 70 --reporter text --include 'get-shit-done/bin/lib/*.cjs' --exclude 'tests/**' --all node scripts/run-tests.cjs"
  }
}
